{
  "name": "@open-hax/website",
  "version": "0.1.0",
  "description": "OpenHax organization portfolio website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CSS,SHADOW \"tailwindcss -c tailwind.config.ts -i src/index.css -o dist/app.css --watch\" \"shadow-cljs watch app\"",
    "build": "tailwindcss -c tailwind.config.ts -i src/index.css -o dist/app.css && shadow-cljs release app",
    "preview": "vite preview",
    "watch:cljs": "shadow-cljs watch app",
    "build:cljs": "shadow-cljs release app"
  },
  "dependencies": {
    "@open-hax/uxx": "0.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.27.0",
    "shadow-cljs": "^2.28.22"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vite": "^5.4.15"
  },
  "license": "LGPL-3.0-or-later"
}

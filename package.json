{
  "name": "@open-hax/website",
  "version": "0.1.0",
  "description": "OpenHax organization portfolio website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:dev": "node scripts/stage-assets.mjs && node scripts/scan-assets.mjs && pnpm exec shadow-cljs release html && node target/build/html.cjs dist/site && node scripts/copy-static.mjs",
    "dev": "pnpm run prepare:dev && concurrently -k -n CSS,SHADOW \"tailwindcss -c tailwind.config.ts -i src/index.css -o dist/site/app.css --watch\" \"shadow-cljs watch app\"",
    "build:site": "node scripts/build-site.mjs",
    "build": "pnpm run build:site",
    "verify:dist": "node scripts/verify-dist.mjs",
    "stage:assets": "node scripts/stage-assets.mjs",
    "gen:assets": "node scripts/scan-assets.mjs",
    "test": "shadow-cljs compile test",
    "lint": "clj-kondo --lint src test"
  },
  "dependencies": {
    "@open-hax/uxx": "0.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.27.0",
    "shadow-cljs": "^2.28.22"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vite": "^5.4.15"
  },
  "license": "LGPL-3.0-or-later"
}
